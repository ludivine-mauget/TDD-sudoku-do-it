<div class="cell @GetCellClasses()" @onclick="OnCellClick">
    @if (Value != 0)
    {
        <span>@Value</span>
    }
</div>

@code {
    [Parameter]
    public int Row { get; set; }

    [Parameter]
    public int Col { get; set; }

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public bool IsFixed { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback OnSelected { get; set; }

    private string GetCellClasses()
    {
        var classes = new List<string>();

        if (IsFixed)
            classes.Add("fixed");

        if (IsSelected)
            classes.Add("selected");

        if (Row % 3 == 0 && Row != 0)
            classes.Add("border-top");
        if (Col % 3 == 0 && Col != 0)
            classes.Add("border-left");

        return string.Join(" ", classes);
    }

    private async Task OnCellClick()
    {
        if (IsFixed)
            return;

        await OnSelected.InvokeAsync();
    }
}

