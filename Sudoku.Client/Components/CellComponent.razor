@inject IJSRuntime JS

<div class="cell @GetCellClasses()" @onclick="OnCellClick">
    @if (Value != 0)
    {
        <span>@Value</span>
    }
    else if (_isEditing)
    {
        <input type="number" 
               min="0" 
               max="9" 
               @bind="_tempValue" 
               @bind:event="oninput"
               @onblur="OnBlur"
               @onkeydown="OnKeyDown"
               @ref="_inputRef"
               class="cell-input" />
    }
</div>

@code {
    private ElementReference _inputRef;
    private bool _isEditing;
    private int _tempValue;

    [Parameter]
    public int Row { get; set; }

    [Parameter]
    public int Col { get; set; }

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public bool IsFixed { get; set; }

    [Parameter]
    public EventCallback<int> OnValueChanged { get; set; }

    private string GetCellClasses()
    {
        var classes = new List<string>();

        if (IsFixed)
            classes.Add("fixed");

        if (_isEditing)
            classes.Add("editing");

        if (Row % 3 == 0 && Row != 0)
            classes.Add("border-top");
        if (Col % 3 == 0 && Col != 0)
            classes.Add("border-left");

        return string.Join(" ", classes);
    }

    private async Task OnCellClick()
    {
        if (IsFixed || _isEditing)
            return;

        _isEditing = true;
        _tempValue = Value;
        StateHasChanged();

        await Task.Delay(10);
        await JS.InvokeVoidAsync("eval", $"document.querySelector('.cell.editing input')?.focus()");
    }

    private async Task OnBlur()
    {
        await CommitValue();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Escape")
        {
            await CommitValue();
        }
    }

    private async Task CommitValue()
    {
        if (!_isEditing)
            return;

        _isEditing = false;

        var newValue = Math.Max(0, Math.Min(9, _tempValue));

        if (newValue != Value)
        {
            await OnValueChanged.InvokeAsync(newValue);
        }

        StateHasChanged();
    }
}

